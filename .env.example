# Frontend-only public values. Never put OIDC_CLIENT_SECRET here.
# Set the secret in server/.env using server/.env.example as the template.
VITE_OIDC_ISSUER=https://auth.example.com
VITE_OIDC_CLIENT_ID=
# Local API URL is derived from dev-ports.json. Set VITE_API_BASE_URL to an
# empty value for production builds when the frontend and API share an origin.